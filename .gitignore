# Signing material and secrets — NEVER commit
build/signing/*.pfx
build/signing/*.pvk
build/signing/*.key
build/signing/*.cer.private
*.snk

# Quarantine vault and runtime state (never commit live artifacts)
*.vault
quarantine_store/
runtime/
*.log
sentinel-state/

# Real malware samples must never be committed
tests/samples/live/
tests/samples/**/*.malware

# Editor / OS
.vs/
.vscode/
.idea/
*.swp
