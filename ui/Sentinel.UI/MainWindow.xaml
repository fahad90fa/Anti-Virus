<Window x:Class="Sentinel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel AV" Height="640" Width="960"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / protection banner -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                Padding="20" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="16" Height="16" Fill="{StaticResource SafeBrush}"
                         VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock Text="{Binding ProtectionBannerText}" FontSize="22"
                               FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding ConnectionState}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Run self-test" Command="{Binding SelfTestCommand}"
                        HorizontalAlignment="Right" Margin="24,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Stat tiles + scan -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Files scanned" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Status.FilesScanned}" FontSize="24"
                               FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Threats blocked" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Status.ThreatsBlocked}" FontSize="24"
                               FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Quarantined" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Status.Quarantined}" FontSize="24"
                               FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Scan a path" Foreground="{StaticResource MutedBrush}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="8,4" />
                        <Button Grid.Column="1" Content="Scan" Command="{Binding ScanCommand}"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detections + quarantine -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="12" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent detections" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="4,4,4,10" />
                    <ListView ItemsSource="{Binding Detections}" Background="Transparent"
                              BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="70"
                                    DisplayMemberBinding="{Binding DisplayTime}" />
                                <GridViewColumn Header="Verdict" Width="90"
                                    DisplayMemberBinding="{Binding Verdict.Level}" />
                                <GridViewColumn Header="Target" Width="260"
                                    DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Reason" Width="200"
                                    DisplayMemberBinding="{Binding Verdict.Summary}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                    Padding="12" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Quarantine" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="4,4,4,10" />
                    <Button DockPanel.Dock="Bottom" Content="Refresh"
                            Command="{Binding RefreshCommand}" Margin="4,10,4,4" />
                    <ListView ItemsSource="{Binding Quarantine}" Background="Transparent"
                              BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="When" Width="120"
                                    DisplayMemberBinding="{Binding DisplayTime}" />
                                <GridViewColumn Header="Original path" Width="220"
                                    DisplayMemberBinding="{Binding OriginalPath}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
