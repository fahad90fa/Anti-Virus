<Application x:Class="Sentinel.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Brand palette -->
        <SolidColorBrush x:Key="BrandBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="SafeBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
